# ==============================================================================
# PantryPal Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Backend Server Configuration
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
# Default: Local SQLite database stored inside backend/ directory
DATABASE_URL=sqlite:///./pantrypal.db
# For PostgreSQL (Docker or production):
# DATABASE_URL=postgresql+psycopg2://pantrypal:pantrypal_secret@db:5432/pantrypal

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Session & Security
# Used for session token hashing and cookie validation
SESSION_SECRET_KEY=change_this_to_a_random_secure_secret_in_production_32chars
SESSION_MAX_AGE_DAYS=14

# Frontend Configuration
VITE_API_URL=/api
PORT=5173
